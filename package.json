{
  "name": "react-example",
  "private": true,
  "version": "6.1.5",
  "description": "A professional transcription and forensic analysis tool for law enforcement, featuring AssemblyAI integration, speaker labeling, and APOD (Analysis of Patterns of Denial) reporting.",
  "author": "Narrative.AI Team",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-electron server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "regress": "tsx src/regression/runRegression.ts",
    "start": "node server.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --outfile=server.cjs --external:vite --external:@huggingface/transformers --format=cjs && esbuild src/services/keyStore.ts --platform=node --format=cjs --outfile=electron/keyStore.cjs",
    "build:all": "npm run build && npm run build:server",
    "electron:pack": "npm run build:all && electron-builder build --win --dir",
    "electron:dist": "npm run build:all && electron-builder build --win"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@vitejs/plugin-react": "^5.0.4",
    "assemblyai": "^4.28.0",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ffmpeg-static-electron": "^2.0.3",
    "ffprobe-static-electron": "^2.0.2",
    "file-saver": "^2.0.5",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.14",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "undici": "^7.30.0",
    "uuid": "^13.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.narrativeai.app",
    "productName": "Narrative AI",
    "buildVersion": "6.1.5",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs",
      "server.cjs",
      "splash.html",
      "recovery.html",
      "logo.png",
      "logo.ico",
      "icon.png",
      "icon.ico",
      "node_modules/**/*",
      "package.json",
      "electron/keyStore.cjs"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "server.cjs",
      "node_modules/better-sqlite3/**/*",
      "node_modules/ffmpeg-static-electron/bin/**/*",
      "node_modules/ffprobe-static-electron/bin/**/*"
    ],
    "win": {
      "icon": "logo.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Narrative AI"
    }
  }
}
