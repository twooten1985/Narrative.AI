# Optional. The desktop app stores API keys with Electron safeStorage.
# These are read only when the server is started outside Electron, and only
# if a key has not already been pushed from the main process.
# ASSEMBLY_AI_API_KEY=
# GEMINI_API_KEY=

# US endpoints are the default. Change them in Settings, or set these only
# while the saved setting is still the US default.
# ASSEMBLYAI_API_BASE=https://api.assemblyai.com
# LLM_GATEWAY_URL=https://llm-gateway.assemblyai.com/v1/chat/completions

# Set by Electron for every packaged and dev desktop launch.
# LOCAL_AUTH_TOKEN=
# APP_USER_DATA_PATH=
